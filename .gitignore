# ── Secrets ──────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
proxy/certs/

# ── Runtime data / backups (live in Docker volumes or off-repo) ─────────────
backups/
*.dump
*.sql.gz

# ── Dependencies & builds ───────────────────────────────────────────────────
node_modules/
.next/
out/
dist-ssr/
# GMB's Vite bundle is built inside its image (npm run build) — the committed
# copy was stale and is excluded from the image by .dockerignore.
apps/gmb/dist/
*.tsbuildinfo
coverage/

# ── App data that must never be committed (PII / secrets) ───────────────────
apps/audit/leads.json
apps/audit/reports/
apps/audit/settings.json
apps/GrowClinic-main/public/uploads/*
!apps/GrowClinic-main/public/uploads/.gitkeep
# prisma CLI output that names the old Hostinger MySQL host/database
apps/GrowClinic-main/prisma_output.txt

# ── OS / editor ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.log
npm-debug.log*

# ── MySQL dumps for the one-off import (production PII) ─────────────────────
database/import/dumps/*
!database/import/dumps/README.md
