# ─────────────────────────────────────────────────────────────────────────────
# GrowClinic platform environment — one file for the whole Docker Compose stack.
#
#   ./scripts/generate-secrets.sh   # creates .env from this file; every CHANGE_ME
#                                   # becomes a fresh random secret
#   ./scripts/preflight.sh          # production: rejects unsafe values
#
# Every variable here is used: docker-compose.yml (or an opt-in override file
# at the end) hands it only to the container that needs it. .env is git-ignored
# — never commit real values, and never paste production credentials into a
# local .env (the local stack really sends email/WhatsApp and calls paid APIs).
#
# Format: KEY=value, no spaces around "=". Wrap a value in single quotes if it
# contains spaces, #, $, quotes or starts with a quote. Secrets used inside
# connection URLs (DB/Redis passwords) must be URL-safe: [A-Za-z0-9._~-], 24+
# chars — generate-secrets.sh produces 48-char hex.
# ─────────────────────────────────────────────────────────────────────────────

# ── Platform ─────────────────────────────────────────────────────────────────
# Node.js major for all images (22 = LTS; 20 reached end-of-life 2026-04-30).
NODE_VERSION=22

# Reverse-proxy host binding. Loopback only — VERIFY the port first:
#   ./scripts/check-ports.sh 18080
# Production: a verified free high port; the VPS Nginx proxies to it.
PROXY_HTTP_BIND=127.0.0.1:18080

# apply = bring the schema up to date on `docker compose up` (local default)
# check = refuse to start apps while migrations are pending (production)
MIGRATE_MODE=apply

# ── PostgreSQL (one database for the whole platform) ─────────────────────────
POSTGRES_DB=growclinic
POSTGRES_SUPERUSER=gc_admin
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME
# Runtime role passwords (roles <app>_app are created/synced by the migrate job)
GROWCLINIC_DB_PASSWORD=CHANGE_ME
AUDIT_DB_PASSWORD=CHANGE_ME
GMB_DB_PASSWORD=CHANGE_ME
ENGINE_DB_PASSWORD=CHANGE_ME
# Server sizing (defaults suit a 4–8 GB VPS shared with other services)
POSTGRES_MAX_CONNECTIONS=60
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_EFFECTIVE_CACHE_SIZE=768MB
POSTGRES_MEMORY_LIMIT=1g

# ── Redis (ACL user per app) ─────────────────────────────────────────────────
REDIS_AUDIT_PASSWORD=CHANGE_ME
REDIS_GMB_PASSWORD=CHANGE_ME

# ── www.growclinic.io — website + CMS (apps/GrowClinic-main) ─────────────────
# Canonical origin, baked in at build time (metadataBase, Open Graph). Keep the
# production URL even for local builds so SEO metadata is identical.
GROWCLINIC_PUBLIC_URL=https://www.growclinic.io
# NextAuth signing secret, and the public origin used for login redirects.
# Local: http://growclinic.localhost:18080   Production: https://www.growclinic.io
GROWCLINIC_AUTH_SECRET=CHANGE_ME
GROWCLINIC_AUTH_URL=http://growclinic.localhost:18080
# IndexNow pings (Bing) when posts are published. "true" in production ONLY —
# a local/staging stack must never announce www.growclinic.io URLs.
GROWCLINIC_INDEXNOW_ENABLED=false
# Search Console / Bing Webmaster meta-tag verification (optional).
GROWCLINIC_GOOGLE_SITE_VERIFICATION=
GROWCLINIC_BING_SITE_VERIFICATION=
# ImageKit media library (admin → posts); upload is disabled while the key is
# empty. Folder: empty = /growclinic/blog.
GROWCLINIC_IMAGEKIT_PRIVATE_KEY=
GROWCLINIC_IMAGEKIT_FOLDER=
# Google Apps Script /exec URL mirroring contact-form leads to a Sheet (optional).
GROWCLINIC_CONTACT_SHEET_WEBHOOK_URL=
# Cal.com webhook signing secret (16+ random chars) — set the same value in
# Cal.com → Settings → Developer → Webhooks. The webhook answers 503 while unset.
GROWCLINIC_CAL_WEBHOOK_SECRET=CHANGE_ME
# Confirmation emails for the contact/booking forms (SMTPS, implicit TLS).
GROWCLINIC_SMTP_HOST=
GROWCLINIC_SMTP_PORT=465
GROWCLINIC_SMTP_USER=
GROWCLINIC_SMTP_PASS=
# WhatsApp Cloud API: https://graph.facebook.com/<version>/<phone-number-id>/messages
GROWCLINIC_WHATSAPP_API_URL=
GROWCLINIC_WHATSAPP_API_TOKEN=
# One-off admin seed (12+ char password; clear it after seeding):
#   docker compose --profile tools run --rm growclinic-seed
GROWCLINIC_SEED_ADMIN_EMAIL=admin@growclinic.io
GROWCLINIC_SEED_ADMIN_PASSWORD=
# The website reaches the audit tool over the private network with
# AUDIT_INTAKE_SECRET and AUDIT_INBOUND_LEADS_KEY (below) — no copies needed here.

# ── audit.growclinic.io — AI audit tool + CRM (apps/audit) ───────────────────
# Integration keys can also be managed in the admin panel. A value set here is
# used whenever the panel has none; AI, GetGabs, SMTP and tracking-tag keys are
# re-imported from here at every start, so manage those in ONE place.
# CORS allow-list (comma-separated origins) and the public base URL of report links.
# Local: http://audit.growclinic.localhost:18080   Production: https://audit.growclinic.io
AUDIT_PUBLIC_ORIGIN=http://audit.growclinic.localhost:18080
AUDIT_PUBLIC_URL=http://audit.growclinic.localhost:18080
# Also serve under a path prefix (e.g. /clinic-audit); empty = root only.
AUDIT_APP_BASE_PATH=
# Shared secret for POST /api/intake (website → tool handoff). Required to enable it.
# Also passed to the website as AUDIT_WEBHOOK_SECRET.
AUDIT_INTAKE_SECRET=CHANGE_ME
# Staff bypass code for maintenance mode.
AUDIT_MAINTENANCE_ACCESS_CODE=CHANGE_ME
# Seeds/syncs the "admin" user password (8+ chars). Clear it after first login.
AUDIT_ADMIN_INITIAL_PASSWORD=
# DEV/RECOVERY ONLY — clears the admin TOTP at start. Never set in production.
AUDIT_ADMIN_DISABLE_2FA=
# Hours before an abandoned empty chat session is discarded.
AUDIT_EMPTY_SESSION_TTL_HOURS=3
# AI providers + Google (Places, PageSpeed).
AUDIT_OPENAI_API_KEY=
AUDIT_GEMINI_API_KEY=
AUDIT_GOOGLE_API_KEY=
# AI cost figures in admin → Usage: INR per USD (empty = 100) and cost multiplier (empty = 3).
AUDIT_USD_INR_RATE=
AUDIT_COST_FACTOR=
# GetGabs WhatsApp Business API — OTP + report delivery.
AUDIT_GETGABS_API_KEY=
AUDIT_GETGABS_SENDER=
AUDIT_GETGABS_CAMPAIGN_ID=
AUDIT_GETGABS_OTP_TEMPLATE=
AUDIT_GETGABS_REPORT_TEMPLATE=
AUDIT_GETGABS_LANG=en_US
# "true" adds the copy-code URL button to the OTP template; template button
# positions (empty = 0).
AUDIT_GETGABS_OTP_COPY_BUTTON=
AUDIT_GETGABS_OTP_BUTTON_INDEX=
AUDIT_GETGABS_REPORT_BUTTON_INDEX=
# Country code assumed for phone numbers entered without one (empty = 91).
AUDIT_DEFAULT_COUNTRY_CODE=
# Report / alert email (SMTP) and the inbox for new-lead alerts.
AUDIT_SMTP_HOST=
AUDIT_SMTP_PORT=465
AUDIT_SMTP_SECURE=true
AUDIT_SMTP_USER=
AUDIT_SMTP_PASS=
AUDIT_SMTP_FROM=
AUDIT_NOTIFY_EMAIL=
# Outbound: new-lead webhook, CRM event stream, Google Sheets live sync.
AUDIT_WEBHOOK_URL=
AUDIT_CRM_EVENTS_WEBHOOK=
AUDIT_SHEETS_WEBHOOK_URL=
# Lead alerts in Telegram (bot token + chat id).
AUDIT_TELEGRAM_BOT_TOKEN=
AUDIT_TELEGRAM_CHAT_ID=
# Auth for POST /api/integrations/inbound/<channel> (12+ chars). Also sent by the
# website as X-Inbound-Key when it forwards contact/booking leads.
AUDIT_INBOUND_LEADS_KEY=CHANGE_ME
# X-API-Key for GET/PATCH /api/crm/leads (16+ chars); empty = CRM API disabled.
AUDIT_CRM_API_KEY=
# Tracking tags injected into the tool's pages.
AUDIT_GA4_ID=
AUDIT_GTM_ID=
AUDIT_META_PIXEL_ID=
AUDIT_CLARITY_ID=
AUDIT_GOOGLE_ADS_ID=
AUDIT_GOOGLE_ADS_LABEL=
AUDIT_GSC_VERIFICATION=
# Meta Conversions API (server-side Lead events; needs AUDIT_META_PIXEL_ID) and
# the Graph API version it calls (empty = v21.0).
AUDIT_META_CAPI_TOKEN=
AUDIT_WA_API_VERSION=
# Meta Lead Ads auto-import (page access token + page id).
AUDIT_META_LEADS_TOKEN=
AUDIT_META_PAGE_ID=
# Marketing tab data sources (read-only): GA4 Data API + Meta Ads insights.
# GA4 service-account JSON must be on ONE line in single quotes — or paste it in
# admin → Tracking instead.
AUDIT_GA4_PROPERTY_ID=
AUDIT_GA4_SA_JSON=
AUDIT_META_GRAPH_TOKEN=
AUDIT_META_AD_ACCOUNT_ID=
# Google Calendar booking invites: OAuth client (connect in admin → Integrations)
# and target calendar (empty = primary).
AUDIT_GCAL_CLIENT_ID=
AUDIT_GCAL_CLIENT_SECRET=
AUDIT_GCAL_CALENDAR_ID=

# ── gmb.growclinic.io — Google Business Profile tool (apps/gmb) ──────────────
# AES-256 key for stored Google OAuth tokens (64 hex chars).
# WARNING: changing it — or GMB_JWT_SECRET — makes stored tokens unreadable
# (clinics would have to reconnect Google).
GMB_TOKEN_ENC_KEY=CHANGE_ME
# Legacy key derivation: leave EMPTY on new installs. Set it only to the old GMB
# environment's JWT_SECRET when importing tokens that were encrypted with it.
GMB_JWT_SECRET=
# HMAC key for POST /api/handoff (audit → gmb). Endpoint returns 503 while unset.
GMB_INBOUND_HANDOFF_KEY=CHANGE_ME
# Google OAuth client for the Business Profile API. The redirect URI must exactly
# match the one registered in Google Cloud.
GMB_GOOGLE_CLIENT_ID=
GMB_GOOGLE_CLIENT_SECRET=
GMB_GOOGLE_REDIRECT_URI=http://gmb.growclinic.localhost:18080/api/google/callback
# Places API key for the public instant audit (search answers 503 while unset).
GMB_GOOGLE_PLACES_API_KEY=
# WhatsApp Cloud API for OTP delivery (messages URL + token).
GMB_WHATSAPP_API_URL=
GMB_WHATSAPP_API_TOKEN=
# LOCAL TESTING ONLY — both must be empty in production (preflight enforces it).
#   GMB_USE_MOCK_GOOGLE_API=true  fakes Google Business Profile API responses
#   GMB_OTP_TEST_MODE=on          returns OTP codes in API responses
GMB_USE_MOCK_GOOGLE_API=
GMB_OTP_TEST_MODE=

# ── engine.growclinic.io — multi-tenant clinic CRM (apps/engine) ─────────────
# The engine only needs its database password (above) at runtime — it has no
# login yet. One-off seed (12+ char password; prints the first activation key once):
#   docker compose --profile tools run --rm engine-seed
ENGINE_SEED_ADMIN_EMAIL=admin@growclinic.io
ENGINE_SEED_ADMIN_PASSWORD=

# ── Opt-in override files (ignored unless that file is used) ─────────────────
# compose.local-https.yml — local HTTPS with mkcert certificates.
PROXY_HTTPS_BIND=127.0.0.1:18443
# compose.dbtools.yml — PostgreSQL / Redis on loopback for GUI tools (never on the VPS).
POSTGRES_HOST_BIND=127.0.0.1:15432
REDIS_HOST_BIND=127.0.0.1:16379
# compose.import.yml — one-off MySQL → PostgreSQL import. The source MySQL is
# throwaway (tmpfs, unpublished); empty passwords use its built-in defaults.
IMPORT_MYSQL_ROOT_PASSWORD=
IMPORT_MYSQL_PASSWORD=
# Zone of CURRENT_TIMESTAMP values in the old audit / gmb MySQL servers
# (check: SELECT @@global.time_zone, @@system_time_zone;). Prisma apps are UTC.
IMPORT_AUDIT_SOURCE_TZ=+00:00
IMPORT_GMB_SOURCE_TZ=+00:00
