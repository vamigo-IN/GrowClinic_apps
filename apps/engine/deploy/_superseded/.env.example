# ── Engine SaaS environment (VPS) ────────────────────────────────────────────
# Copy to `.env` in this deploy/ folder and fill in. NEVER commit the real .env.

# MySQL (created by the db container)
DB_PASSWORD=change_me_strong
DB_ROOT_PASSWORD=change_me_stronger

# Prisma connects to the db service over the compose network (host = "db")
DATABASE_URL="mysql://engine:change_me_strong@db:3306/engine"

# Session signing secret (long random string):  openssl rand -hex 48
SESSION_SECRET=change_me_to_a_long_random_string

# Seed admin (used once by `npm run seed` to create the PLATFORM super admin)
ADMIN_EMAIL=admin@growclinic.io
ADMIN_PASSWORD=change-me-now

# Public base URL of the engine
ENGINE_BASE_URL=https://engine.growclinic.io
