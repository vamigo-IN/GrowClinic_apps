# Engine env for running OUTSIDE the platform stack (e.g. `next dev`).
# Inside Docker these come from the root .env via docker-compose.yml.
# Copy to `.env` (git-ignored). Schema: `./scripts/migrate.sh apply` at the repo root.
DATABASE_URL="postgresql://engine_app:PASSWORD@127.0.0.1:15432/growclinic?schema=engine&connection_limit=5"

# Seed admin (used by `npm run seed`) — no default password; 12+ characters.
ADMIN_EMAIL=admin@growclinic.io
ADMIN_PASSWORD=
