# ─────────────────────────────────────────────────────────────
# GrowClinic Audit Tool — environment template
# Copy to .env and fill in real values.  Do NOT commit .env.
#
# NOTE: Most integration keys (AI, Google, WhatsApp, SMTP, tracking,
# webhooks) can ALSO be set live in the Admin panel (Tracking /
# Integrations) with no redeploy. Any key here is read as a fallback
# via getSetting(): the DB/admin value wins, env is the bootstrap.
# The only values that MUST come from env are the ones marked (env-only).
# ─────────────────────────────────────────────────────────────

# ── Core server (env-only) ───────────────────────────────────
NODE_ENV=production                 # enables Secure cookies in prod
PORT=3000
HOST=0.0.0.0
# Comma-separated allowed browser origins (CORS). REQUIRED in prod —
# if unset the app only accepts localhost and the live site breaks.
PUBLIC_ORIGIN=https://audit.growclinic.io
PUBLIC_URL=https://audit.growclinic.io
# APP_BASE_PATH=                     # set only if served under a sub-path
# DATA_DIR=/data                     # persistent volume for DB + reports
# REPORTS_DIR=/data/reports          # defaults to <DATA_DIR>/reports

# ── Database — PostgreSQL (env-only) ─────────────────────────
# In the GrowClinic platform stack these are set by docker-compose.yml from
# the root .env — this block is only for running the app outside Docker.
# The schema is created by the platform migrate job, never by the app.
DATABASE_URL=postgresql://audit_app:PASSWORD@127.0.0.1:15432/growclinic
DB_SCHEMA=audit
DB_POOL_MAX=6

# ── Redis (optional; handoff tokens survive restarts) ────────
# REDIS_URL=redis://audit:PASSWORD@127.0.0.1:16379

# ── AI + Google APIs (bootstrap; also settable in Admin) ─────
OPENAI_API_KEY=                     # final report writing + fallback
GEMINI_API_KEY=                     # chat conversation + lead extraction
GOOGLE_API_KEY=                     # Places API (GMB) + PageSpeed Insights

# ── WhatsApp delivery — GetGabs (OTP + report delivery) ──────
GETGABS_API_KEY=
GETGABS_SENDER=                     # sender / WABA phone
GETGABS_CAMPAIGN_ID=
GETGABS_OTP_TEMPLATE=               # approved template name for OTP
GETGABS_REPORT_TEMPLATE=            # approved template name for report link
GETGABS_LANG=en_US
# GETGABS_OTP_COPY_BUTTON=false
# GETGABS_OTP_BUTTON_INDEX=0
# GETGABS_REPORT_BUTTON_INDEX=0

# ── Email — SMTP (OTP for non-IN markets, report + alerts) ───
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true                    # true for 465, false for 587
SMTP_USER=no-reply@growclinic.io    # SMTP login only
SMTP_PASS=
SMTP_FROM=no-reply@growclinic.io    # single sender identity
NOTIFY_EMAIL=                       # where internal alerts go

# ── Secure handoff + maintenance (env-only, security) ────────
# Shared secret with the Next.js site's audit webhook. REQUIRED so the
# /api/intake handoff can't be forged.
INTAKE_SECRET=
# Staff bypass code for maintenance mode. MUST be set — there is no
# baked-in default anymore. Use a long random string.
MAINTENANCE_ACCESS_CODE=

# ── Lead delivery / CRM webhooks (also settable in Admin) ────
WEBHOOK_URL=                        # CRM / Google Sheet / Make.com on lead capture
CRM_EVENTS_WEBHOOK=                 # n8n / event stream
SHEETS_WEBHOOK_URL=
INBOUND_LEADS_KEY=                  # auth key for POST /api/integrations/inbound
CRM_API_KEY=                        # auth for GET /api/crm/leads

# ── Tracking IDs (primary home is Admin → Tracking) ──────────
GA4_ID=
GTM_ID=
META_PIXEL_ID=
CLARITY_ID=
GOOGLE_ADS_ID=

# ── Admin bootstrap / dev toggles ────────────────────────────
# ADMIN_INITIAL_PASSWORD=           # seed the admin password (else auto-generated & printed once)
# ADMIN_DISABLE_2FA=                # DEV ONLY — never set in prod
# EMPTY_SESSION_TTL_HOURS=3

# ── Cost accounting (optional) ───────────────────────────────
# COST_FACTOR=1
# USD_INR_RATE=83
