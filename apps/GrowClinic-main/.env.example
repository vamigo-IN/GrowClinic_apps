# ─────────────────────────────────────────────────────────────
# GrowClinic.io — Next.js site — environment template
# Copy to .env (or .env.local) and fill in real values. Do NOT commit.
# ─────────────────────────────────────────────────────────────

# ── Database — MySQL (required) ──────────────────────────────
# IMPORTANT: on shared hosting (Hostinger) MySQL caps concurrent connections
# (often ~25). Always bound Prisma's pool with connection_limit so a traffic or
# crawler spike can't exhaust the DB and 500 the public pages. pool_timeout and
# connect_timeout keep a brief DB blip from hanging a request forever.
#   ...?connection_limit=5&pool_timeout=20&connect_timeout=15
DATABASE_URL="mysql://user:pass@host:3306/dbname?connection_limit=5&pool_timeout=20&connect_timeout=15"

# ── Auth — NextAuth v5 (required) ────────────────────────────
# Long random string. AUTH_SECRET is the v5 name; NEXTAUTH_SECRET also accepted.
AUTH_SECRET=
NEXTAUTH_SECRET=
# Public base URL of the site (used for canonical URLs, OG, sitemap).
NEXT_PUBLIC_APP_URL=https://www.growclinic.io
# First-run admin seed (used by the seed script). Remove after first login.
DEFAULT_ADMIN=admin@growclinic.io
DEFAULT_PASS=

# ── Audit tool handoff (required for the /audit funnel) ──────
# Must point at the audit tool's intake endpoint and share its secret.
AUDIT_WEBHOOK_URL=https://audit.growclinic.io/api/intake
AUDIT_WEBHOOK_SECRET=                # MUST equal the audit tool's INTAKE_SECRET

# ── Media uploads — ImageKit (required for CMS media library) ─
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_FOLDER=/growclinic
# UPLOAD_DIR=                        # local fallback upload dir (optional)

# ── Email — SMTP (contact form + notifications) ──────────────
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=no-reply@growclinic.io
SMTP_PASS=

# ── WhatsApp (optional — CTA / notifications) ────────────────
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# ── Cal.com booking webhook (optional) ───────────────────────
CAL_WEBHOOK_SECRET=

# ── Lead forwarding (optional) ───────────────────────────────
CONTACT_SHEET_WEBHOOK_URL=           # Google Sheet / n8n for contact submissions

# ── SEO site verification (optional) ─────────────────────────
GOOGLE_SITE_VERIFICATION=            # GSC meta-tag method
BING_SITE_VERIFICATION=
